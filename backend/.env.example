# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id-here

# KIRA Chatbot (required)
OPENAI_API_KEY=sk-...your-openai-key-here...

# KIRA Chatbot (optional overrides)
# KIRA_MODEL=gpt-4o-mini          # default: gpt-4o-mini
# KIRA_BASE_URL=                  # any OpenAI-compatible provider base URL
# KIRA_TOKEN_PARAM=max_tokens     # use max_completion_tokens for o1/o3 models

# Translation APIs (Optional - For Phase 2 live translation)
# Bhashini API (Primary) - Apply at https://bhashini.gov.in/ulca/user/register
BHASHINI_API_KEY=your-bhashini-api-key-here
BHASHINI_USER_ID=your-bhashini-user-id-here

# Google Translate API (Fallback) - Get from https://console.cloud.google.com/apis/credentials
GOOGLE_TRANSLATE_API_KEY=your-google-translate-api-key-here

# Database
DATABASE_URL=sqlite:///db.sqlite3

# Email (for notifications)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Govt Email Domains for Department validation
GOV_EMAIL_DOMAINS=gov.in,nic.in,mygov.in

# Sahayak AI Engine
AI_ENABLED=true
AI_ASSISTANT_NAME=Sahayak
LLM_PROVIDER=gemini        # mock | gemini
LLM_API_KEY=               # same as GEMINI_API_KEY if using gemini
AI_MAX_INPUT_CHARS=6000
AI_WORKERS=3
